{
  "name": "dgdtools",
  "displayName": "DGD LPC (dgdtools)",
  "description": "DGD-dialect LPC: syntax highlighting, brackets and comments for the language `dgdlpc`.",
  "version": "0.0.1",
  "publisher": "dgdtools",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mmcdole/dgdtools.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "lpc",
    "dgd",
    "mud",
    "lpmud"
  ],
  "activationEvents": [
    "workspaceContains:**/dgdtools.yml",
    "workspaceContains:**/.dgdtools.yml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dgdlpc",
        "aliases": [
          "DGD LPC",
          "dgdlpc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dgdlpc",
        "scopeName": "source.dgdlpc",
        "path": "./syntaxes/dgdlpc.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[dgdlpc]": {
        "files.autoGuessEncoding": true
      }
    }
  }
}
