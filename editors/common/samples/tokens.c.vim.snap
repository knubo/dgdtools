#                                             ^^^^ dgdlpcCharacter dgdlpcEscape
#                                                 ^ dgdlpcCharacter
#                                                     ^^^ dgdlpcCharacter
#                                                           ^^^ dgdlpcCharacter
>    str = "plain" + "esc \n \t \" \\ \101 \x41 \q" + "" + "/* no comment */";
#          ^^^^^^^ dgdlpcString
#                    ^^^^^ dgdlpcString
#                         ^^ dgdlpcString dgdlpcEscape
#                            ^^ dgdlpcString dgdlpcEscape
#                               ^^ dgdlpcString dgdlpcEscape
#                                  ^^ dgdlpcString dgdlpcEscape
#                                     ^^^^ dgdlpcString dgdlpcEscape
#                                          ^^^^ dgdlpcString dgdlpcEscape
#                                               ^^ dgdlpcString dgdlpcEscape
#                                                 ^ dgdlpcString
#                                                     ^^ dgdlpcString
#                                                          ^^^^^^^^^^^^^^^^^^ dgdlpcString
>    str = "continued \
#          ^^^^^^^^^^^^ dgdlpcString
>on the next line" + "// no comment";
#^^^^^^^^^^^^^^^^^ dgdlpcString
#                    ^^^^^^^^^^^^^^^ dgdlpcString
>    arr = arr[1..2] + arr[..3] + arr[i..] + arr[0 .. 1] + arr[i + 1 ..];
#             ^ dgdlpcSubscript
#              ^ dgdlpcSubscript dgdlpcNumber
#               ^^ dgdlpcSubscript dgdlpcOperator
#                 ^ dgdlpcSubscript dgdlpcNumber
