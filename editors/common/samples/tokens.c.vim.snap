>static int
#^^^^^^ dgdlpcSpecifier
#       ^^^ dgdlpcType
>operators(int a, int b, object ob, mixed args...)
#^^^^^^^^^ dgdlpcFunction
#          ^^^ dgdlpcType
#                 ^^^ dgdlpcType
#                        ^^^^^^ dgdlpcType
#                                   ^^^^^ dgdlpcType
#                                             ^^^ dgdlpcOperator
>{
>    a = b; a += b; a -= b; a *= b; a /= b; a %= b;
>    a &= b; a |= b; a ^= b; a <<= b; a >>= b;
>    a = a + b - a * b / a % b;
>    a = a & b | a ^ ~b;
>    a = a << 2 >> 1;
#             ^ dgdlpcNumber
#                  ^ dgdlpcNumber
>    a = a == b || a != b && a < b || a > b && a <= b || a >= b || !a;
>    a++; b--; ++a; --b;
>    a = a ? b : -a;
>    a = ob <- "/std/room";
#           ^^ dgdlpcOperator
#              ^^^^^^^^^^^ dgdlpcString
>    ob->call(a, b, args...);
#      ^^ dgdlpcOperator
#        ^^^^ dgdlpcFunction
#                       ^^^ dgdlpcOperator
>    ob = new object "/data/thing";
#         ^^^ dgdlpcKeyword
#             ^^^^^^ dgdlpcType
#                    ^^^^^^^^^^^^^ dgdlpcString
>    room::create();
#    ^^^^ dgdlpcInheritLabel
#        ^^ dgdlpcOperator
#          ^^^^^^ dgdlpcFunction
>    ::create();
#    ^^ dgdlpcOperator
#      ^^^^^^ dgdlpcFunction
>    return f(a[i]) + g(([ ]), ({ }), ([ a: b[0] ])[a]) + sizeof(({ a, b }));
#    ^^^^^^ dgdlpcStatement
#           ^ dgdlpcFunction
#              ^^^ dgdlpcSubscript
#                     ^ dgdlpcFunction
#                       ^^ dgdlpcMapping dgdlpcMappingDelim
#                          ^^ dgdlpcMappingDelim
#                              ^^ dgdlpcArray dgdlpcArrayDelim
#                                 ^^ dgdlpcArrayDelim
#                                     ^^ dgdlpcMapping dgdlpcMappingDelim
#                                       ^^^^^ dgdlpcMapping
#                                            ^ dgdlpcMapping dgdlpcSubscript
#                                             ^ dgdlpcMapping dgdlpcSubscript dgdlpcNumber
#                                              ^ dgdlpcMapping dgdlpcSubscript
#                                                ^^ dgdlpcMappingDelim
#                                                  ^^^ dgdlpcSubscript
#                                                         ^^^^^^ dgdlpcFunction
#                                                                ^^ dgdlpcArray dgdlpcArrayDelim
#                                                                  ^^^^^^ dgdlpcArray
#                                                                        ^^ dgdlpcArrayDelim
>}
>
>static void
#^^^^^^ dgdlpcSpecifier
#       ^^^^ dgdlpcType
>keywords(int n, string function)
#^^^^^^^^ dgdlpcFunction
#         ^^^ dgdlpcType
#                ^^^^^^ dgdlpcType
>{
>    int i;
#    ^^^ dgdlpcType
>
>    if (n)
#    ^^ dgdlpcConditional
>        n = 1;
#            ^ dgdlpcNumber
>    else if (!n) {
#    ^^^^ dgdlpcConditional
#         ^^ dgdlpcConditional
>        n = 2;
#            ^ dgdlpcNumber
>    } else
#      ^^^^ dgdlpcConditional
>        return;
#        ^^^^^^ dgdlpcStatement
>    for (i = 0; i < n; i++)
#    ^^^ dgdlpcRepeat
#             ^ dgdlpcNumber
>        continue;
#        ^^^^^^^^ dgdlpcStatement
>    while (n--)
#    ^^^^^ dgdlpcRepeat
>        break;
#        ^^^^^ dgdlpcStatement
>    do {
#    ^^ dgdlpcRepeat
>        n++;
>    } while (n < 10);
#      ^^^^^ dgdlpcRepeat
#                 ^^ dgdlpcNumber
>    switch (n) {
#    ^^^^^^ dgdlpcConditional
>    case 1:
#    ^^^^ dgdlpcLabel
#         ^ dgdlpcNumber
>    case 2..3:
#    ^^^^ dgdlpcLabel
#         ^ dgdlpcNumber
#          ^^ dgdlpcOperator
#            ^ dgdlpcNumber
>        break;
#        ^^^^^ dgdlpcStatement
>    case 'a':
#    ^^^^ dgdlpcLabel
#         ^^^ dgdlpcCharacter
>        goto out;
#        ^^^^ dgdlpcStatement
>    default:
#    ^^^^^^^ dgdlpcLabel
>        return;
#        ^^^^^^ dgdlpcStatement
>    }
>    catch {
#    ^^^^^ dgdlpcException
>        n = 1 / 0;
#            ^ dgdlpcNumber
#                ^ dgdlpcNumber
>    } : {
>        n = 0;
#            ^ dgdlpcNumber
>    }
>    try {
#    ^^^ dgdlpcException
>        n = 1;
#            ^ dgdlpcNumber
>    } catch (err) {
#      ^^^^^ dgdlpcException
>        n = 2;
#            ^ dgdlpcNumber
>    }
>    rlimits (10; 1000) {
#    ^^^^^^^ dgdlpcStatement
#             ^^ dgdlpcNumber
#                 ^^^^ dgdlpcNumber
>        function = catch(call_other(this_object(), function, n));
#                   ^^^^^ dgdlpcException
#                         ^^^^^^^^^^ dgdlpcFunction
#                                    ^^^^^^^^^^^ dgdlpcFunction
>    }
>out:
>    NAME = MAX_COUNT + __DGD__ + _x + X + T1;
#    ^^^^ dgdlpcMacro
#           ^^^^^^^^^ dgdlpcMacro
#                       ^^^^^^^ dgdlpcMacro
#                                          ^^ dgdlpcMacro
>}
>
>static int
#^^^^^^ dgdlpcSpecifier
#       ^^^ dgdlpcType
>operator+ (int n)
#^^^^^^^^ dgdlpcKeyword
