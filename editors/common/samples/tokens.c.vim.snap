>    return ({ str, f, i, nil, ([ "a": 1, "b": ({ 2, 3 }), arr[0]: arr[1] ]) });
#    ^^^^^^ dgdlpcStatement
#           ^^ dgdlpcArray dgdlpcArrayDelim
#             ^^^^^^^^^^^^ dgdlpcArray
#                         ^^^ dgdlpcArray dgdlpcConstant
