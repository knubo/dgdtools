#                   ^^ dgdlpcFloat
#                        ^^^^ dgdlpcFloat
#                               ^^^^^^ dgdlpcFloat
#                                        ^^^^ dgdlpcFloat
#                                               ^^^^ dgdlpcFloat
>    i = 0 + 7 + 42 + 0x1f + 0XFF + 017;
#        ^ dgdlpcNumber
#            ^ dgdlpcNumber
#                ^^ dgdlpcNumber
#                     ^^^^ dgdlpcNumber
#                            ^^^^ dgdlpcNumber
#                                   ^^^ dgdlpcNumber
>    i = 'a' + '\n' + '\'' + '\\' + '\101' + '\x41' + '"' + '/';
#        ^^^ dgdlpcCharacter
#              ^ dgdlpcCharacter
#               ^^ dgdlpcCharacter dgdlpcEscape
#                 ^ dgdlpcCharacter
#                     ^ dgdlpcCharacter
#                      ^^ dgdlpcCharacter dgdlpcEscape
#                        ^ dgdlpcCharacter
#                            ^ dgdlpcCharacter
#                             ^^ dgdlpcCharacter dgdlpcEscape
